# Settings of scripts/fpf_query_token_gate_uv.sh, one KEY=VALUE per line, read by the script (never sourced).
# The supported CPython range matches scripts/fpf_query_token_gate.sh: from FPF_GATE_PYTHON_MIN up to, but
# excluding, FPF_GATE_PYTHON_BELOW.
FPF_GATE_PYTHON_MIN=3.10
FPF_GATE_PYTHON_BELOW=3.14
# Lowest uv release the script accepts (exercised with 0.13.7).
FPF_GATE_UV_MIN_VERSION=0.13.0
